class Solution {
    public void gameOfLife(int[][] board) {

        int[] col = new int[]{-1, -1, -1, 0, 0, 1, 1, 1};
        int[] row = new int[]{-1, 0, 1, -1, 1, -1, 0, 1};

        for(int i = 0; i < board.length; i++)
        {
            for(int j = 0; j < board[0].length; j++)
            {
                int count = 0;
                for(int k = 0; k < col.length; k++)
                {
                    if(i + col[k] < board.length && i + col[k] >= 0 && j + row[k] < board[0].length && j + row[k] >= 0)
                    {
                        count += board[i + col[k]][j + row[k]] % 2;
                    }
                }
                
                if((count == 3) || (count == 2 && board[i][j] == 1))
                    board[i][j] += 2;
            }
        }

        for(int i = 0; i < board.length; i++)
        {
            for(int j = 0; j < board[0].length; j++)
            {
                if(board[i][j] != 0 && board[i][j] != 1)
                    board[i][j] = 1;
                else if(board[i][j] == 1)
                    board[i][j] = 0;
            }
        }
    }
}
