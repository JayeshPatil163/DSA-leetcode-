        Queue<Integer> q = new LinkedList<>();
        int[] color = new int[graph.length];

        for (int j = 0; j < graph.length; j++) {
            if (color[j] == 0) {
                q.add(j);
                color[j] = -1;
                while (!q.isEmpty()) {
                    int i = q.poll();

                    for (int ele : graph[i]) {
                        if (color[ele] == 0) {
                            color[ele] = color[i] * -1;
                            q.add(ele);
                        } else if (color[ele] == color[i]) {
                            return false;
                        }
                    }
                }
            }
        }
        return true;
    }
